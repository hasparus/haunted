#!/usr/bin/env bash
# Headless Unity for this project: tests and builds without opening the editor.
#
#   tools/unity test [editmode|playmode|all] [unity args...]   results in TestResults/<mode>.xml, failures printed
#   tools/unity build <BuildTarget> [--dev] [unity args...]     the player in Builds/<BuildTarget>/
#   tools/unity run [unity args...]                              anything else, e.g. -executeMethod Some.Method -quit
#   tools/unity deactivate                                       hand this machine's license seat back
#
# For example: tools/unity test editmode -testFilter TouchTests, or tools/unity build StandaloneLinux64.
# Play tests marked Explicit (soak, perf, online) only run when -testFilter names them.
#
# The editor is the version in ProjectSettings/ProjectVersion.txt, found at $UNITY_EDITOR, in Unity Hub's default
# folders, or in /opt/unity (tools/install-unity.sh). It must be licensed: on a desktop, sign in to Unity Hub once; on a
# headless machine, set UNITY_EMAIL and UNITY_PASSWORD and it's activated here (see activate below).
# Close the project in the editor first: Unity won't open one project twice.
# Unity's full log goes to Logs/<command>.log; only what matters is printed.
set -uo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^m_EditorVersion: //p' ProjectSettings/ProjectVersion.txt)

find_editor() {
  for e in "${UNITY_EDITOR:-}" \
    "/Applications/Unity/Hub/Editor/$version/Unity.app/Contents/MacOS/Unity" \
    "$HOME/Unity/Hub/Editor/$version/Editor/Unity" \
    "${UNITY_ROOT:-/opt/unity}/$version/Editor/Unity"; do
    if [ -n "$e" ] && [ -x "$e" ]; then
      echo "$e"
      return
    fi
  done
  echo "Unity $version isn't installed. Get it from Unity Hub, run tools/install-unity.sh (Linux), or set UNITY_EDITOR." >&2
  exit 1
}

unity=$(find_editor) || exit 1

# A license, activated once per machine from the environment, the way game-ci does it:
#   UNITY_EMAIL + UNITY_PASSWORD                 a Personal seat (an account without two-factor sign-in)
#   UNITY_EMAIL + UNITY_PASSWORD + UNITY_SERIAL  a Pro or Plus seat
#   UNITY_LICENSE                                a Unity_lic.ulf, which only works on the machine it was issued to
# Each activation holds one of the account's seats until `tools/unity deactivate` hands it back.
licensed() {
  for dir in "$HOME/.local/share/unity3d" "$HOME/.config/unity3d" "/Library/Application Support/Unity"; do
    [ -d "$dir" ] && [ -n "$(find "$dir" \( -name Unity_lic.ulf -o -name UnityEntitlementLicense.xml \) -print -quit 2>/dev/null)" ] && return 0
  done
  return 1
}

licensing_client() {
  find "$(dirname "$unity")/.." -name Unity.Licensing.Client -type f -perm -u+x -print -quit 2>/dev/null
}

activate() {
  licensed && return 0
  mkdir -p Logs
  local log=Logs/activate.log status
  if [ -n "${UNITY_EMAIL:-}" ] && [ -n "${UNITY_PASSWORD:-}" ] && [ -n "${UNITY_SERIAL:-}" ]; then
    echo "Activating Unity with a serial for $UNITY_EMAIL"
    "$unity" -batchmode -nographics -quit -serial "$UNITY_SERIAL" -username "$UNITY_EMAIL" -password "$UNITY_PASSWORD" -logFile "$log"
    status=$?
  elif [ -n "${UNITY_EMAIL:-}" ] && [ -n "${UNITY_PASSWORD:-}" ]; then
    echo "Activating a Unity Personal seat for $UNITY_EMAIL"
    "$(licensing_client)" --activate-all --include-personal --username "$UNITY_EMAIL" --password "$UNITY_PASSWORD" > "$log" 2>&1
    status=$?
    # The client can succeed without assigning a seat.
    grep -qiE "No seat available|No license activation found" "$log" && status=1
  elif [ -n "${UNITY_LICENSE:-}" ]; then
    echo "Activating the Unity license file in UNITY_LICENSE"
    local file
    file=$(mktemp)
    printf '%s' "$UNITY_LICENSE" | tr -d '\r' > "$file"
    "$unity" -batchmode -nographics -quit -manualLicenseFile "$file" -logFile "$log"
    status=$?
    rm -f "$file"
  else
    return 0
  fi
  if [ $status -ne 0 ]; then
    echo "Activation failed ($status); see $log" >&2
    grep -iE "error|seat|machine binding" "$log" | head -5 >&2
    exit 1
  fi
}

deactivate() {
  if [ -z "${UNITY_EMAIL:-}" ] || [ -z "${UNITY_PASSWORD:-}" ]; then
    echo "Set UNITY_EMAIL and UNITY_PASSWORD to hand the seat back." >&2
    exit 1
  fi
  mkdir -p Logs
  "$unity" -batchmode -nographics -quit -returnlicense -username "$UNITY_EMAIL" -password "$UNITY_PASSWORD" -logFile Logs/deactivate.log &&
    echo "Returned this machine's Unity seat"
}

# Runs Unity on the project, logging to Logs/$1.log; on failure prints the errors and the end of the log.
unity_run() {
  local log="Logs/$1.log"
  shift
  mkdir -p Logs
  "$unity" -batchmode -nographics -projectPath "$PWD" -logFile "$log" "$@"
  local status=$?
  if [ $status -ne 0 ]; then
    echo "Unity exited with $status; full log in $log" >&2
    grep -E "error CS[0-9]+|Scripts have compiler errors|No valid Unity Editor license|Exception:|\[BuildScript\]" "$log" | sort -u | head -40 >&2
    tail -n 15 "$log" >&2
    if grep -q "No valid Unity Editor license" "$log"; then
      echo "No Unity license here: set UNITY_EMAIL and UNITY_PASSWORD (see the top of tools/unity)." >&2
    fi
  fi
  return $status
}

# Counts and failures from an NUnit results file.
summarize() {
  python3 - "$1" <<'EOF'
import sys, xml.etree.ElementTree as ET
run = ET.parse(sys.argv[1]).getroot()
print(f"{run.get('passed')} passed, {run.get('failed')} failed, {run.get('skipped')} skipped of {run.get('total')} "
      f"in {float(run.get('duration', 0)):.0f}s")
for case in run.iter('test-case'):
    if case.get('result') == 'Failed':
        message = case.find('failure/message')
        print(f"FAILED {case.get('fullname')}\n    {(message.text or '').strip()[:800]}")
EOF
}

run_tests() {
  local mode=$1 platform
  shift
  case "$mode" in
    editmode) platform=EditMode ;;
    playmode) platform=PlayMode ;;
    *) echo "Test modes are editmode, playmode and all" >&2; exit 1 ;;
  esac
  local results="TestResults/$mode.xml"
  mkdir -p TestResults
  rm -f "$results"
  echo "Running $platform tests"
  unity_run "test-$mode" -runTests -testPlatform "$platform" -testResults "$PWD/$results" "$@"
  local status=$?
  if [ -f "$results" ]; then summarize "$results"; fi
  return $status
}

command=${1:-}
shift || true
case "$command" in
  test)
    activate
    mode=${1:-all}
    [ $# -gt 0 ] && shift
    if [ "$mode" = all ]; then
      run_tests editmode "$@"
      edit=$?
      run_tests playmode "$@"
      play=$?
      [ $edit -eq 0 ] && [ $play -eq 0 ]
    else
      run_tests "$mode" "$@"
    fi
    ;;
  build)
    activate
    target=${1:?"tools/unity build <BuildTarget>, e.g. StandaloneLinux64, WebGL, Android, iOS"}
    shift
    dev=()
    if [ "${1:-}" = --dev ]; then
      dev=(-development)
      shift
    fi
    echo "Building $target"
    unity_run "build-$target" -quit -buildTarget "$target" -executeMethod Demons.Editor.BuildScript.Build ${dev[@]+"${dev[@]}"} "$@" &&
      grep "\[BuildScript\]" "Logs/build-$target.log"
    ;;
  run)
    activate
    unity_run run "$@"
    ;;
  deactivate)
    deactivate
    ;;
  *)
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    exit 1
    ;;
esac
